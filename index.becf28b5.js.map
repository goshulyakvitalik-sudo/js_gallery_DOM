var mainImage = document.querySelector("#largeImg");
gallery.addEventListener("click", function(ev) {
    ev.preventDefault();
    var target = ev.target;
    if (target.tagName === "IMG") target = target.parentElement;
    if (target.tagName !== "A") return;
